{
  "version": 2,
  "builds": [
    {
      "src": "api/*-postgres.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/register",
      "dest": "/api/register-postgres.js"
    },
    {
      "src": "/api/login",
      "dest": "/api/login-postgres.js"
    },
    {
      "src": "/api/validate-session",
      "dest": "/api/validate-session-postgres.js"
    },
    {
      "src": "/api/logout",
      "dest": "/api/logout-postgres.js"
    },
    {
      "src": "/(.*)",
      "dest": "/src/$1"
    }
  ],
  "env": {
    "POSTGRES_URL": "@postgres_url",
    "POSTGRES_SSL": "true"
  }
}
