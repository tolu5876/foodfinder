{
  "version": 2,
  "builds": [
    {
      "src": "api/register-demo.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/login-demo.js", 
      "use": "@vercel/node"
    },
    {
      "src": "api/validate-session-demo.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/logout-demo.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/register",
      "dest": "/api/register-demo.js"
    },
    {
      "src": "/api/login",
      "dest": "/api/login-demo.js"
    },
    {
      "src": "/api/validate-session",
      "dest": "/api/validate-session-demo.js"
    },
    {
      "src": "/api/logout",
      "dest": "/api/logout-demo.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
